# [Python/Environment]
# 가상환경 폴더 (팀원들이 각자 생성해야 함)
.venv/
venv/
env/

# 파이썬 실행 캐시 (속도 향상을 위해 자동 생성됨)
__pycache__/
*.py[cod]

# [Security]
# API 키나 비밀번호가 들어갈 파일
.env

# [Data & Models]
# 대용량 데이터 및 AI 모델 가중치 (Git 용량 초과 방지)
backend/data/
backend/crawler/
backend/vector_db/
*.pt
*.pth
*.bin
*.zip

# [OS]
# 운영체제에서 자동 생성하는 임시 파일
.DS_Store
Thumbs.db

backend/.env
backend/.venv/

# .gitignore 파일 내용
.env
venv/
